{
  "name": "osht-site",
  "private": true,
  "version": "2.0.0",
  "description": "Public website of OSHT - Agro Trading (Om Shri Hari Trading Pvt Ltd). Built to static files and placed at the repo root.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 8787 --strictPort",
    "images": "sh scripts/images.sh",
    "place": "sh scripts/place.sh"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "gsap": "3.15.1",
    "lucide-react": "1.72.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
